OPENAI_API_KEY=
TAVILY_API_KEY=

# Phase 5 observability (optional) — get a key at https://smith.langchain.com
# All LangChain agents pick these up automatically, no code changes needed.
# When creating the key: Service Key, scoped to a Specific Workspace (not
# Full Organization) — an org-scoped key 403s on trace ingestion.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sdr-account-brief-agent
# Only needed if your LangSmith account is outside the US region — reads
# still succeed with the wrong endpoint, but trace ingestion silently
# 403s. Check your account's region in LangSmith settings if traces don't
# show up despite a valid key. EU example: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
